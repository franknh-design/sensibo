# 2GM Varme - Konfigurasjon
# Kopier denne filen til .env og fyll inn verdiene

# Sensibo API-nøkkel (hentes fra home.sensibo.com → Settings → API)
SENSIBO_API_KEY=din_nøkkel_her

# Navn på enheten slik den heter i Sensibo-appen
SENSIBO_DEVICE_NAME=Frank's device AC

# Koordinater for met.no (Finnsnes)
METNO_LAT=69.2333
METNO_LON=17.9833

# Port web-server kjører på
SERVER_PORT=8765
